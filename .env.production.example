# ============================================================
# TEMPLATE KONFIGURASI PRODUCTION
# Copy file ini ke .env di server production.
# JANGAN commit file .env ke Git!
# ============================================================

APP_NAME="EduSoal AI"
APP_ENV=production
APP_KEY=          # Jalankan: php artisan key:generate
APP_DEBUG=false   # WAJIB false di production
APP_URL=https://yourdomain.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error   # Di production cukup log error saja

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edusoal_ai
DB_USERNAME=        # Ganti dengan user non-root
DB_PASSWORD=        # Ganti dengan password kuat

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true   # WAJIB true di production
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.yourmailprovider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# API Keys — Isi dengan key yang sudah di-rotate
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Rate limiting
GENERATE_RATE_LIMIT=5
GENERATE_DAILY_LIMIT=50
